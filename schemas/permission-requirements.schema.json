{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "azd solution permission requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "solutionId", "status", "coverage", "reviewedOn", "requirements", "gaps"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "solutionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "status": { "enum": ["implemented", "proposed", "legacy", "template"] },
    "coverage": { "enum": ["partial", "complete"] },
    "reviewedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": { "properties": { "coverage": { "const": "complete" } } },
      "then": { "properties": { "gaps": { "maxItems": 0 } } },
      "else": { "properties": { "gaps": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "relativePath": { "type": "string", "pattern": "^(?!.*:)(?![A-Za-z]:)(?!/)(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001F]+$" },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "documentationUrl": { "type": "string", "pattern": "^https://" }
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["resource", "kind", "permission", "principal", "phase", "feature", "defaultEnabled", "scope", "rationale", "evidenceState", "evidence"],
      "properties": {
        "resource": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["application", "delegated", "azure-rbac", "entra-role", "exchange-rbac", "connector"] },
        "permission": { "$ref": "#/$defs/text" },
        "principal": { "$ref": "#/$defs/text" },
        "phase": { "enum": ["discovery", "deployment", "runtime", "cleanup"] },
        "feature": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "defaultEnabled": { "type": "boolean" },
        "scope": { "$ref": "#/$defs/text" },
        "rationale": { "$ref": "#/$defs/text" },
        "evidenceState": { "enum": ["code", "documented", "proposed"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    }
  }
}
